APP_ID=vismriti
APP_NAME=Vismriti
APP_VERSION=0.1.0

ERASURE_AGENT_MODEL=openai:gpt-5.6

OPENAI_API_KEY=sk-...

DATAHUB_GMS_URL=https://datahub-gms.happyhill-72aa3202.centralindia.azurecontainerapps.io
DATAHUB_GMS_TOKEN=
DATAHUB_MCP_COMMAND=uvx
DATAHUB_MCP_ARGS=mcp-server-datahub

# --- WAREHOUSE (demo-only Postgres) ---
# Vismriti's core job is to READ metadata from DataHub and WRITE the
# audit-trail entity back to DataHub. It does NOT strictly need warehouse
# credentials.
#
# For the local `healthcare-datapack` DEMO, however, the executor +
# subject_resolver want to actually run the generated SQL against a
# Postgres instance shipped in docker-compose. That's what these vars are.
#
# In production, most customers should:
#   (a) leave these unset, and
#   (b) plug their own executor (e.g. a dbt job or Airflow DAG) that
#       consumes Vismriti's plan output (`.actions[].sql` / `.command`)
#       and runs it via their existing warehouse governance channels.
# Vismriti will still emit the plan + write the audit trail; the actual
# DELETE just happens outside this process.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=healthcare
PG_USER=datahub
PG_PASSWORD=datahub



AGENTOS_HOST=127.0.0.1
AGENTOS_PORT=8000

AGENTOS_MCP_SERVER=true        # expose Vismriti AS an MCP server
AGENTOS_TRACING=true           # OpenTelemetry traces (in-process for demo)
AGENTOS_TELEMETRY=false        # Agno's own product telemetry (opt out)
AGENTOS_A2A=false              # agent-to-agent interface
AGENTOS_DB_URL=sqlite:///./runs/vismriti.db


ERASURE_AGENT_DRY_RUN=true

ERASURE_AGENT_OUTPUT_DIR=./runs

ERASURE_AGENT_MAX_LINEAGE_DEPTH=5

# --- SLACK (opt-in; fully wired in vismriti.main) ---
# When SLACK_ENABLED=true, main.py mounts /slack/events + /slack/interactions
# on the AgentOS FastAPI app and Agno's native HITL flow renders per-action
# Approve/Reject Block Kit buttons. Setup guide: docs/slack_setup.md
#
# To enable, uncomment the two secrets below AND flip SLACK_ENABLED=true.
# Both must be non-empty or main.py raises RuntimeError at boot.
SLACK_ENABLED=false
# SLACK_BOT_TOKEN=xoxb-your-bot-token-from-slack-app-oauth-page
# SLACK_SIGNING_SECRET=your-signing-secret-from-slack-app-basic-info
SLACK_REPLY_TO_MENTIONS_ONLY=true


APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=INFO

VISMRITI_USE_FIXTURES=true
VISMRITI_FIXTURE_SUBJECT_ID=48291
